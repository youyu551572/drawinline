# ============================================================
# YouYu 中转服务器 - 环境变量配置
# 复制此文件为 .env 并填写真实值
# ============================================================

# --- 客户端与服务端共享的 API 密钥 ---
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-api-key-here-change-me

# --- SMTP 邮箱配置 (QQ邮箱) ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@foxmail.com
SMTP_PASS=your-smtp-auth-code

# --- Flask 内部密钥 ---
SECRET_KEY=your-flask-secret-key

# --- 管理员密钥（可选，管理接口用） ---
ADMIN_KEY=your-admin-key

# --- 数据库路径（可选） ---
# DB_PATH=./data.db
